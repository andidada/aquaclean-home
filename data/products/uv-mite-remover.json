  "reviews": [
    {
      "name": "Emily Watson",
      "location": "Melbourne, Australia",
      "rating": 5,
      "date": "2025-12-10",
      "title": "UV-C light actually kills dust mites — lab test proved it",
      "body": "We had our mattress and sofa tested before and after using this mite remover. The UV-C exposure at the certified 253.7nm wavelength reduced mite count by 97%. The photos show our mattress before and after treatment. Highly recommended for allergy sufferers.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/uv-mite-remover/uv-1.jpg",
        "https://www.hkdmj.net/assets/images/products/uv-mite-remover/uv-2.jpg"
      ]
    },
    {
      "name": "David Kim",
      "location": "Houston, TX, USA",
      "rating": 4,
      "date": "2025-10-02",
      "title": "Great for mattresses and curtains — very effective against allergens",
      "body": "I have allergic rhinitis and have been looking for a non-chemical solution. This UV-C mite remover has significantly reduced my symptoms. The vibrating pad loosens dust and the suction pulls it away. One caveat: hold it in each spot for at least 30 seconds for maximum effect.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/uv-mite-remover/uv-3.jpg",
        "https://www.hkdmj.net/assets/images/products/uv-mite-remover/uv-4.jpg"
      ]
    },
    {
      "name": "Patricia Souza",
      "location": "Lisbon, Portugal",
      "rating": 5,
      "date": "2025-08-15",
      "title": "The HEPA filter inside captures everything — no more morning sneezing",
      "body": "Our bedroom smelled fresh after just 3 treatments. The HEPA filter is easy to remove and wash. The UV-C lamp replacement indicator is a useful feature. Ordered 200 units for our local store and they sold out in 6 weeks.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/uv-mite-remover/uv-5.jpg",
        "https://www.hkdmj.net/assets/images/products/uv-mite-remover/uv-6.jpg"
      ]
    }
  ],
