  "reviews": [
    {
      "name": "Wei Zhang",
      "location": "Singapore",
      "rating": 5,
      "date": "2025-11-20",
      "title": "Finally safe window cleaning on our 30th floor apartment",
      "body": "Living on the 30th floor, window cleaning has always been dangerous. This robot handles both exterior and interior glass with its AI-powered path planning. The safety rope holds 150kg. Our windows have never been this clean.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/window-cleaner-robot-gm1-c/01.webp",
        "https://www.hkdmj.net/assets/images/products/window-cleaner-robot-gm1-c/02.webp"
      ]
    },
    {
      "name": "Olivia Brown",
      "location": "San Francisco, CA, USA",
      "rating": 5,
      "date": "2025-09-08",
      "title": "Perfect for floor-to-ceiling glass offices",
      "body": "We manage a small office building and this robot has replaced our quarterly window cleaning service. It works on any glass thickness from 3mm to 35mm and the edge detection prevents it from falling off. The 3.5m extension cord covers most spaces.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/window-cleaner-robot-gm1-c/01.webp",
        "https://www.hkdmj.net/assets/images/products/window-cleaner-robot-gm1-c/02.webp"
      ]
    },
    {
      "name": "Marco Rossi",
      "location": "Milan, Italy",
      "rating": 4,
      "date": "2025-07-22",
      "title": "Works well on large glass panels — minor learning curve",
      "body": "It takes about 5 minutes to learn the remote control and the app. Once you know how to set the cleaning path, it does an excellent job. Best results are on smooth, frameless glass. Ours are framed windows so it leaves a small 2cm gap at the edges.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/window-cleaner-robot-gm1-c/01.webp",
        "https://www.hkdmj.net/assets/images/products/window-cleaner-robot-gm1-c/02.webp"
      ]
    }
  ],
