  "reviews": [
    {
      "name": "Kevin Murphy",
      "location": "Denver, CO, USA",
      "rating": 5,
      "date": "2025-12-01",
      "title": "Digital gauge is accurate to ±0.1 PSI — matches my professional inflator",
