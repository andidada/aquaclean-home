      ]
    },
    {
      "name": "Rachel Thompson",
      "location": "Auckland, New Zealand",
      "rating": 5,
      "date": "2025-09-14",
      "title": "Steam mops are the only way to clean hardwood without warping it",
      "body": "Our realtor recommended we get a steam mop before listing our house. The variable steam settings let us use it safely on our laminate flooring. It comes with 10 accessories and they all snap on easily. Great product.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/steam-cleaner/sc-3.jpg",
        "https://www.hkdmj.net/assets/images/products/steam-cleaner/sc-4.jpg"
      ]
    },
    {
      "name": "Henrik Larsen",
      "location": "Copenhagen, Denmark",
      "rating": 5,
