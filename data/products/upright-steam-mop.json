  "reviews": [
    {
      "name": "Sandra Kim",
      "location": "Seoul, South Korea",
      "rating": 5,
      "date": "2025-11-12",
      "title": "Cleans and sanitizes all hard floors in one pass — no chemicals needed",
      "body": "With two toddlers on the floor all day, chemical residues were a big concern. This steam mop uses only water and heats to 145°C, killing 99.9% of bacteria. The washable microfiber pad lasts through dozens of washes. See the steam action photos.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/upright-steam-mop/usm-1.jpg",
        "https://www.hkdmj.net/assets/images/products/upright-steam-mop/usm-2.jpg"
      ]
    },
    {
      "name": "Robert Green",
      "location": "London, UK",
      "rating": 5,
      "date": "2025-10-08",
      "title": "Heavier commercial model is worth it — cleans our entire hotel in 40 minutes",
      "body": "We run a 20-room boutique hotel and needed something more robust than consumer steam mops. This commercial unit has a 1.6L tank and 2500W heating element. The steam is ready in 30 seconds and it continuously for 30 minutes. The carpet glider attachment is included.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/upright-steam-mop/usm-3.jpg",
        "https://www.hkdmj.net/assets/images/products/upright-steam-mop/usm-4.jpg"
      ]
    },
    {
      "name": "Marie Dubois",
      "location": "Paris, France",
      "rating": 4,
      "date": "2025-07-27",
      "title": "Lightweight and maneuverable — cleans under furniture with the low-profile head",
      "body": "The triangular head reaches corners and the low profile (6cm) slides under our beds and sofas. The 360° swivel head makes it easy to navigate around chair legs. Steam power is adjustable between 2 levels. The 280ml water tank lasts about 20 minutes.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/upright-steam-mop/usm-5.jpg",
        "https://www.hkdmj.net/assets/images/products/upright-steam-mop/usm-6.jpg"
      ]
    }
  ],
