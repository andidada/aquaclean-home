  "reviews": [
    {
      "name": "Lucas Schmidt",
      "location": "Berlin, Germany",
      "rating": 5,
      "date": "2025-11-05",
      "title": "Professional 20-bar pressure and PID temperature control at an unbeatable price",
      "body": "I have been roasting coffee for 10 years and this machine produces cafe-quality espresso at home. The PID-controlled boiler maintains 93°C ±1°C. The steam wand produces microfoam for latte art. The attached photos show the extraction and the milk texturing.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/coffee-machine/cm-1.jpg",
        "https://www.hkdmj.net/assets/images/products/coffee-machine/cm-2.jpg"
      ]
    },
    {
      "name": "Isabella Romano",
      "location": "Rome, Italy",
      "rating": 5,
      "date": "2025-09-18",
      "title": "OEM quality that rivals DeLonghi and Gaggia at half the price",
      "body": "As an Italian I am picky about espresso. This machine pulls a rich crema with our medium roast blend. The dual-boiler system lets us steam milk and pull shots simultaneously. The LED display and touch controls are intuitive and responsive.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/coffee-machine/cm-3.jpg",
        "https://www.hkdmj.net/assets/images/products/coffee-machine/cm-4.jpg"
      ]
    },
    {
      "name": "Jessica Chen",
      "location": "Vancouver, Canada",
      "rating": 4,
      "date": "2025-08-04",
      "title": "Great for our boutique cafe — 200 unit order arrived perfectly packed",
      "body": "We opened a 12-seat cafe and needed a reliable semi-automatic espresso machine within budget. This one delivers consistent shots across a 6-hour shift. We did a test run of 200 espressos in one day and the machine performed without any issues.",
      "photoUrls": [
        "https://www.hkdmj.net/assets/images/products/coffee-machine/cm-5.jpg",
        "https://www.hkdmj.net/assets/images/products/coffee-machine/cm-6.jpg"
      ]
    }
  ],
