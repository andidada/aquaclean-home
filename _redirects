# Netlify Redirects — Multi-language URL handling
# Each language version lives in its subdirectory

/*    /en/               200  Language=en
# Arabic (RTL)
/ar/*   /ar/:splat      200  Language=ar

# Southeast Asian languages
/vi/*   /vi/:splat      200  Language=vi
/th/*   /th/:splat      200  Language=th
/id/*   /id/:splat      200  Language=id

# More languages can be added here as you create them
# /ru/*   /ru/:splat      200
# /es/*   /es/:splat      200
# /fr/*   /fr/:splat      200

# Admin CMS
/admin/*   /admin/:splat   200
